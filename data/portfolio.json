      },
      {
        "number": "02",
        "tool": "Supermaven",
        "phase": "Fast completion",
        "description": "Adopted faster, context-aware completion for day-to-day implementation."
      },
      {
        "number": "03",
        "tool": "Cursor",
        "phase": "AI-native editor",
        "description": "Moved to codebase-aware conversations and changes inside the editor."
      },
      {
        "number": "04",
        "tool": "Claude Code",
        "phase": "Agentic workflows",
        "description": "Expanded into terminal-based planning, implementation, and review workflows."
      },
      {
        "number": "05",
        "tool": "Codex",
        "phase": "Repository agents",
        "description": "Use repository-level agents to implement, validate, and document complete changes."
      }
    ]
